tests/test_loadsave.exe

# NOTE: gui/translations/*.qm (compiled from muibuilderqt_de.ts via lrelease)
# is intentionally NOT ignored here - MuiBuilderQt.pro has no automatic
# lrelease build step, and images.qrc/translations.qrc embed that .qm file
# by path at build time, so a fresh clone without it present would fail to
# build. Regenerate it with `lrelease translations/muibuilderqt_de.ts` after
# editing the .ts, and commit the updated .qm alongside it.

# --- Windows deploy/install staging (regenerated by the build, see
#     gui/MuiBuilderQt.pro's win32{} block and MuiBuilderQt_install/MuiBuilderQt.iss)
MuiBuilderQt_install/install_src/
MuiBuilderQt_install/Output/

# --- Debian/Ubuntu packaging build artifacts (see debian/rules) -----------
# Everything below is generated by `dpkg-buildpackage`/`debuild`; the actual
# packaging SOURCES (debian/control, debian/rules, debian/changelog, etc.)
# are tracked normally and are NOT covered by any pattern here.
debian/build/
debian/muibuilderqt/
debian/muibuilderqt-dbgsym/
debian/.debhelper/
debian/*.debhelper.log
debian/*.debhelper
debian/*.substvars
debian/files
debian/debhelper-build-stamp
debian/*.log
/*.deb
/*.ddeb
/*.changes
/*.buildinfo

